{
  "expo": {
    "name": "QR Captain",
    "slug": "qrcaptain",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "qrcaptain",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0284c7"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qrcaptain.app",
      "infoPlist": {
        "NSCameraUsageDescription": "QR Captain needs camera access to scan vessel QR codes"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0284c7"
      },
      "package": "com.qrcaptain.app",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow QR Captain to access your camera to scan vessel QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow QR Captain to access your photos to upload work order images."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
