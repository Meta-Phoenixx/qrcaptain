# ===========================================
# QR Captain - Web App Environment Variables
# ===========================================
# Two deployments exist:
#
#   Working dev  (tame-grasshopper-654)  → .env.local
#   Refactor dev (ceaseless-pheasant-78) → .env.dev.local
#
# To switch to the refactor sandbox:
#   cp .env.dev.local .env.local
# To switch back to working dev:
#   restore your original .env.local

# Convex deployment URL (from your Convex dashboard)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Sentry DSN for error monitoring (optional, but recommended for production)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
