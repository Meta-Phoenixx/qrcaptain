{
  "meta": {
    "name": "QR Captain Glass Design System",
    "version": "1.0.0",
    "description": "A futuristic, glassmorphism-based design system for high-end software interfaces.",
    "last_updated": "2026-02-05"
  },
  "typography": {
    "font_families": {
      "heading": "Ubuntu, sans-serif",
      "body": "Inter, sans-serif",
      "mono": "JetBrains Mono, monospace"
    },
    "weights": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "scale": {
      "h1": {
        "size": "2.5rem",
        "line_height": "1.2",
        "weight": 700,
        "letter_spacing": "-0.02em"
      },
      "h2": {
        "size": "2rem",
        "line_height": "1.25",
        "weight": 700,
        "letter_spacing": "-0.01em"
      },
      "h3": {
        "size": "1.5rem",
        "line_height": "1.3",
        "weight": 500,
        "letter_spacing": "-0.01em"
      },
      "h4": {
        "size": "1.25rem",
        "line_height": "1.4",
        "weight": 500,
        "letter_spacing": "0em"
      },
      "body_lg": {
        "size": "1.125rem",
        "line_height": "1.5",
        "weight": 400
      },
      "body_base": {
        "size": "1rem",
        "line_height": "1.5",
        "weight": 400
      },
      "body_sm": {
        "size": "0.875rem",
        "line_height": "1.5",
        "weight": 400
      },
      "caption": {
        "size": "0.75rem",
        "line_height": "1.4",
        "weight": 400,
        "text_transform": "uppercase",
        "letter_spacing": "0.05em"
      }
    }
  },
  "colors": {
    "background": {
      "app_bg": "#0F0F13",
      "app_bg_secondary": "#1A1A23",
      "overlay_dim": "rgba(0, 0, 0, 0.6)"
    },
    "glass": {
      "surface_base": "rgba(255, 255, 255, 0.05)",
      "surface_highlight": "rgba(255, 255, 255, 0.1)",
      "surface_active": "rgba(255, 255, 255, 0.15)",
      "border_subtle": "rgba(255, 255, 255, 0.1)",
      "border_highlight": "rgba(255, 255, 255, 0.2)"
    },
    "text": {
      "primary": "#FFFFFF",
      "secondary": "#A1A1AA",
      "tertiary": "#71717A",
      "disabled": "#52525B"
    },
    "accent": {
      "primary": "#3B82F6",
      "primary_glow": "rgba(59, 130, 246, 0.5)",
      "secondary": "#8B5CF6",
      "success": "#10B981",
      "warning": "#F59E0B",
      "error": "#EF4444",
      "info": "#06B6D4"
    },
    "gradients": {
      "primary_action": "linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%)",
      "active_state": "linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(59, 130, 246, 0.1) 100%)"
    }
  },
  "effects": {
    "glassmorphism": {
      "card": {
        "backdrop_filter": "blur(20px) saturate(180%)",
        "background": "rgba(255, 255, 255, 0.05)",
        "border": "1px solid rgba(255, 255, 255, 0.1)",
        "box_shadow": "0 8px 32px 0 rgba(0, 0, 0, 0.37)"
      },
      "overlay": {
        "backdrop_filter": "blur(10px)",
        "background": "rgba(15, 15, 19, 0.8)"
      },
      "input": {
        "background": "rgba(0, 0, 0, 0.2)",
        "border": "1px solid rgba(255, 255, 255, 0.1)",
        "backdrop_filter": "blur(10px)"
      }
    },
    "shadows": {
      "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
      "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
      "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
      "glow_primary": "0 0 15px rgba(59, 130, 246, 0.5)"
    },
    "radius": {
      "sm": "8px",
      "md": "16px",
      "lg": "24px",
      "full": "9999px"
    }
  },
  "layout": {
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px"
    },
    "grid": {
      "columns": 12,
      "gutter": "24px",
      "margin": "24px"
    },
    "breakpoints": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px"
    }
  },
  "components": {
    "buttons": {
      "primary": {
        "description": "High emphasis actions. Glass background with accent glow or gradient.",
        "styles": {
          "background": "var(--gradients-primary-action)",
          "border": "1px solid var(--glass-border-highlight)",
          "color": "var(--text-primary)",
          "padding": "12px 24px",
          "radius": "var(--radius-full)",
          "font_weight": "600"
        }
      },
      "secondary": {
        "description": "Medium emphasis. Ghost style with subtle border.",
        "styles": {
          "background": "transparent",
          "border": "1px solid var(--glass-border-subtle)",
          "color": "var(--text-secondary)"
        }
      }
    },
    "cards": {
      "standard": {
        "description": "Standard container for content modules.",
        "styles": {
          "mixin": "glassmorphism-card",
          "radius": "var(--radius-lg)",
          "padding": "var(--spacing-6)"
        }
      },
      "interactive": {
        "description": "Cards that act as buttons or navigation items.",
        "styles": {
          "hover_transform": "translateY(-2px)",
          "hover_bg": "var(--glass-surface-highlight)"
        }
      }
    },
    "inputs": {
      "text_field": {
        "description": "Text input fields.",
        "styles": {
          "background": "var(--effects-glassmorphism-input-background)",
          "border": "var(--effects-glassmorphism-input-border)",
          "radius": "var(--radius-md)",
          "padding": "12px 16px",
          "color": "var(--text-primary)",
          "placeholder_color": "var(--text-tertiary)"
        }
      },
      "toggle": {
        "description": "Switch toggles for boolean settings.",
        "styles": {
          "track_bg_off": "rgba(255, 255, 255, 0.1)",
          "track_bg_on": "var(--accent-primary)",
          "thumb_bg": "#FFFFFF",
          "height": "24px",
          "width": "44px"
        }
      },
      "slider": {
        "description": "Range sliders.",
        "styles": {
          "track_bg": "rgba(255, 255, 255, 0.1)",
          "fill_bg": "linear-gradient(to right, var(--accent-info), var(--accent-secondary))",
          "thumb_bg": "#FFFFFF"
        }
      }
    },
    "navigation": {
      "bottom_tab": {
        "description": "Floating bottom navigation bar.",
        "styles": {
          "position": "fixed bottom center",
          "background": "rgba(15, 15, 19, 0.8)",
          "backdrop_filter": "blur(20px)",
          "radius": "var(--radius-full)",
          "border": "1px solid var(--glass-border-subtle)"
        }
      },
      "header": {
        "description": "Top navigation header.",
        "styles": {
          "background": "transparent",
          "padding": "var(--spacing-4)"
        }
      }
    },
    "modals": {
      "dialog": {
        "description": "Overlay dialogs.",
        "styles": {
          "overlay": "var(--background-overlay_dim)",
          "container": "glassmorphism-card",
          "radius": "var(--radius-lg)"
        }
      }
    }
  }
}
