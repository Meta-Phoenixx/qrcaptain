# ===========================================
# QR Captain - Convex Backend Environment Variables
# ===========================================
# Two deployments exist:
#
#   Working dev  (tame-grasshopper-654)  → .env.local
#   Refactor dev (ceaseless-pheasant-78) → .env.dev.local
#
# To target the refactor sandbox for npx convex dev:
#   cp .env.dev.local .env.local
# To switch back:
#   restore your original .env.local
#
# These variables must also be set in the Convex dashboard under
# Settings > Environment Variables for each deployment separately.

# Auth secret used to sign JWTs (generate with: openssl rand -base64 32)
AUTH_SECRET=

# RSA private key for JWT signing (base64 encoded)
JWT_PRIVATE_KEY=

# JSON Web Key Set (JWKS) for JWT verification (base64 encoded)
JWKS=

# The URL of your Convex HTTP actions endpoint
SITE_URL=https://your-deployment.convex.site

# Resend API key for sending emails
AUTH_RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
