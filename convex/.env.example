# ===========================================
# QR Captain - Convex Backend Environment Variables
# ===========================================
# These variables must be set in your Convex dashboard under Settings > Environment Variables.
# Do NOT commit actual values to version control.

# Auth secret used to sign JWTs (generate with: openssl rand -base64 32)
AUTH_SECRET=

# RSA private key for JWT signing (base64 encoded)
JWT_PRIVATE_KEY=

# JSON Web Key Set (JWKS) for JWT verification (base64 encoded)
JWKS=

# The URL of your Convex HTTP actions endpoint (e.g. https://your-deployment.convex.site)
# This must match the domain in auth.config.ts
SITE_URL=https://your-deployment.convex.site

# Resend API key for sending password reset emails
# Sign up at https://resend.com and create an API key
AUTH_RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
